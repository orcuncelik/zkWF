# zkWF Verifier Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Private key for deployment (without 0x prefix)
# Get this from your wallet (e.g., MetaMask: Account Details > Export Private Key)
PRIVATE_KEY=your_private_key_here

# Infura Project ID (for Ethereum networks)
# Get this from https://infura.io
INFURA_PROJECT_ID=your_infura_project_id

# Etherscan API Key (for contract verification on Ethereum)
# Get this from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key
